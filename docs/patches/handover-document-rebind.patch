+const hospital={id:'h1',key:'h1',name:'Synthetic Clinic',sn:'SN1'};
+await store.bridge('seed',{hospitals:[hospital],references:{engineers:[],minimumLevel:1}});await store.bridge('activate',{manifest:await store.manifest()});
+const write=(action,p)=>store.handle({action,operationId:crypto.randomUUID(),...p},who);
+const form={hospitalKey:'h1',symptom:'synthetic',cs:who.name,status:'접수',registeredAt:'2026-10-22T09:00',visitAt:'2026-10-22T10:00'};
+const a=await write('work_save',{form});assert.ok(a.success,a.error);
+const source={recordId:'synthetic_source',hospitalName:hospital.name,date:'2026-10-22',sn:'SN1',gubun:'점검',result:'정상',detail:'synthetic',version:'v1',observedAt:new Date().toISOString()};
