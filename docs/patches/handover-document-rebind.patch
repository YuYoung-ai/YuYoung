+const document={recordId:source.recordId,pdf,context:{hospitalName:source.hospitalName,date:source.date,sn:source.sn},requestId:a.request.id};
+await store.bridge('documents',{documents:[document]});
+let d=await store.handle({action:'work_detail',id:a.request.id},who);assert.equal(d.history.filter(h=>h.attachment).length,1);
+assert.ok((await write('work_delete',{requestId:a.request.id,baseRevision:d.request.revision})).success);
